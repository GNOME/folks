#: backends/ofono/ofono-backend.vala:196
msgid ""
"No oFono object manager running, so the oFono backend will be inactive. "
"Either oFono isn’t installed or the service can’t be started."
msgstr ""
"Ingen oFono-objekthandsamar køyrer, så oFono-backenden vert inaktiv. Anten "
"er ikkje oFono installert, eller så kan ikkje tenesta startast."

#: backends/telepathy/lib/tpf-persona-store.vala:1263
msgid "Telepathy contacts representing the local user may not be removed."
msgstr ""
"Telepathy-kontaktar som representerer den lokale brukaren kan ikkje "
"fjernast."

#. Translators: the parameter is an error message.
#: backends/telepathy/lib/tpf-persona-store.vala:1274
#, c-format
msgid "Failed to remove a persona from store: %s"
msgstr "Klarte ikkje fjerne ein persona frå lageret: %s"

#. Translators: the first two parameters are store identifiers and
#. * the third is a contact identifier.
#: backends/telepathy/lib/tpf-persona-store.vala:1309
#, c-format
